  "description": "FHIR R4 aligned read/search interface over the AIIA Clinical Trial Management System. Designed for ABDM sandbox interoperability. Read-only: no create/update/delete is exposed on the FHIR surface.",
  "kind": "instance",
  "software": {
    "name": "AIIA CTMS Backend",
    "version": "1.0.0"
  },
  "implementation": {
    "description": "AIIA CTMS FHIR endpoint",
    "url": "http://localhost:8001/api/fhir"
  },
  "fhirVersion": "4.0.1",
  "format": [
    "json",
    "application/fhir+json"
  ],
